<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Umbraco — pinned to the v17 line. Each Umbraco major (v18, v19, …) requires a
         deliberate verification pass before we widen the range, so consumers on a future
         Umbraco major won't accidentally install this package against an unverified host.
         Range syntax: [17.3.0,18.0.0-0) means >= 17.3.0 and < 18.0.0-0. The "-0" upper
         bound is deliberate: a bare 18.0.0 upper bound still admits 18.0.0 prereleases
         (e.g. 18.0.0-beta) because in NuGet a prerelease sorts *before* its final release.
         "-0" is the lowest possible 18.0.0 prerelease label, so < 18.0.0-0 excludes every
         18.x beta/rc as well as the final 18.0.0. -->
    <PackageVersion Include="Umbraco.Cms" Version="[17.3.0,18.0.0-0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.3.0,18.0.0-0)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.3.0,18.0.0-0)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[17.3.0,18.0.0-0)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[17.3.0,18.0.0-0)" />
    <PackageVersion Include="uSync" Version="[17.0.4,18.0.0-0)" />
    <!-- Entity Framework Core: track Umbraco's transitive version (floor only). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <!-- Build / versioning -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <!--
      Transient dependency version overrides: force non-vulnerable versions of packages
      pulled in transitively via Umbraco/ASP.NET. Paired with top-level PackageReference
      entries in the affected projects. These entries (and the corresponding PackageReferences)
      can be deleted once the transient dependencies are fixed upstream.
      - MailKit: GHSA-9j88-vvj5-vhgr (moderate) in < 4.16.0
      - System.Security.Cryptography.Xml: GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf (high) in < 10.0.6
    -->
    <PackageVersion Include="MailKit" Version="4.16.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.6" />
  </ItemGroup>
</Project>
