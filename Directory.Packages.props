<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Umbraco — pinned to the v19 line. Each Umbraco major (v20, v21, …) requires a
         deliberate verification pass before we widen the range, so consumers on a future
         Umbraco major won't accidentally install this package against an unverified host.
         Range syntax: [19.0.0-beta1,20.0.0) means >= 19.0.0-beta1 and < 20.0.0.
         TODO(v19 release): move the floor to the stable 19.0.0 release (see RELEASE.md), so
         consumers never resolve to a prerelease of the host. The beta floor is only for
         testing against the 19.0.0 prereleases. -->
    <PackageVersion Include="Umbraco.Cms" Version="[19.0.0-beta1,20.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[19.0.0-beta1,20.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[19.0.0-beta1,20.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[19.0.0-beta1,20.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[19.0.0-beta1,20.0.0)" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="19.0.0-beta1" />
    <PackageVersion Include="uSync" Version="[19.0.0-beta01,20.0.0)" />
    <!-- Entity Framework Core: pinned to exactly match the version Umbraco 19.0.0-beta1 references
         (11.0.0-rc.3.26522.148). Using a different version triggers an MSB3277 assembly-version
         conflict with Umbraco's own EF Core reference, so we deliberately track the host version
         here and move it with every Umbraco prerelease/release. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <!-- Build / versioning -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
