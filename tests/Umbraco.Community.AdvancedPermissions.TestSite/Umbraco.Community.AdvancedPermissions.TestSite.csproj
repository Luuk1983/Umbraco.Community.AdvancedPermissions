<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Umbraco.Community.AdvancedPermissions.TestSite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.AdvancedPermissions\Umbraco.Community.AdvancedPermissions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manual-testing site pins Umbraco to a specific patch (VersionOverride wins over
         the central [17.3.0,18.0.0-0) range in Directory.Packages.props). This keeps local
         testing on a known-good build; bump it deliberately when validating a newer CMS. -->
    <PackageReference Include="Umbraco.Cms" VersionOverride="17.5.3" />
    <PackageReference Include="uSync" />
  </ItemGroup>

</Project>
